#!/usr/bin/env bash
# Claude Code plugin bin/: added to the Bash tool PATH while the plugin is enabled.
# Does not download or install the CLI. If the real binary is missing, print an
# explicit install command and exit.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
SELF="${SELF_DIR}/$(basename "$0")"
REAL="${HOME}/.ravi/bin/ravi"

find_other_ravi() {
  local dir cand
  local IFS=':'
  for dir in ${PATH}; do
    [ -n "$dir" ] || continue
    cand="${dir}/ravi"
    [ -x "$cand" ] || continue
    [ "$cand" = "$SELF" ] && continue
    [ "$cand" = "$REAL" ] && continue
    # Skip other copies of this wrapper (shell script), keep compiled binaries.
    if head -c 2 "$cand" 2>/dev/null | grep -q '^#!'; then
      continue
    fi
    printf '%s\n' "$cand"
    return 0
  done
  return 1
}

if other="$(find_other_ravi)"; then
  exec "$other" "$@"
fi

if [ -x "$REAL" ] && ! head -c 2 "$REAL" 2>/dev/null | grep -q '^#!'; then
  exec "$REAL" "$@"
fi

echo "ravi: CLI is not installed. This wrapper does not download it." >&2
echo "Install explicitly, then retry:" >&2
echo "  brew install ravi-hq/tap/ravi" >&2
echo "  # skills only (not the CLI binary): npx skills add ravi-hq/ravi-skills" >&2
echo "  # or, from a checkout of this repo (checksummed release):" >&2
echo "  bash scripts/install-cli.sh" >&2
echo "  export PATH=\"\$HOME/.ravi/bin:\$PATH\"" >&2
exit 127
